{
  "name": "cp-test-studio",
  "version": "0.1.0",
  "description": "Ứng dụng desktop biên soạn đề và tạo bộ test lập trình thi đấu",
  "main": "out/main/index.js",
  "author": "CP Test Studio",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "npm run prepare:mingw",
    "prepare:mingw": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-mingw.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json",
    "build": "electron-vite build",
    "dist:win": "npm run prepare:mingw && electron-builder --win zip --x64",
    "dist:win:installer": "npm run prepare:mingw && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@google/genai": "^1.25.0",
    "archiver": "^7.0.1",
    "docx": "^9.9.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.0",
    "openai": "^6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "vn.cpteststudio.desktop",
    "productName": "CP Test Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".tools/mingw64",
        "to": "toolchain/mingw64",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "CP-Test-Studio-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
